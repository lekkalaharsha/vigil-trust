# Copy to .env and adjust. Never commit a real .env with production values.

# --- Edge gateway ---
VIGIL_GATEWAY_ID=gw-demo-01
VIGIL_VEHICLE_PROFILE_ID=demo-v1
VIGIL_ACQUISITION_MODE=simulator          # simulator | replay | pcan | socketcan | unoq
VIGIL_REPLAY_LOG=data/synthetic_can.log
VIGIL_DEVICE_KEY_PATH=certs/devices/gw-demo-01.key
VIGIL_BACKEND_URL=http://127.0.0.1:8443
VIGIL_EDGE_DATA_DIR=data/edge
VIGIL_BATCH_SIZE=20
VIGIL_DRAIN_INTERVAL_S=1.0

# --- Backend ---
VIGIL_BACKEND_HOST=127.0.0.1
VIGIL_BACKEND_PORT=8443
VIGIL_BACKEND_DATA_DIR=data/backend
VIGIL_BACKEND_CHECKPOINT_KEY=certs/backend_signing/checkpoint.key

# --- MQTT (optional transport; see edge/transport/mqtt.py) ---
VIGIL_MQTT_HOST=127.0.0.1
VIGIL_MQTT_PORT=8883
VIGIL_MQTT_CA_CERT=certs/ca.crt
VIGIL_MQTT_CLIENT_CERT=certs/devices/gw-demo-01.crt
VIGIL_MQTT_CLIENT_KEY=certs/devices/gw-demo-01.key

# --- PCAN (see docs/PCAN_SETUP.md) ---
CAN_INTERFACE=pcan
CAN_CHANNEL=PCAN_USBBUS1
CAN_BITRATE=500000
CAN_FD=false
CAN_LISTEN_ONLY=true
